{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Allowed postgresql major release"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["postgresql"],
      "allowedVersions": "<17"
    },
    {
      "description": ["Hold ceph at stable major, dev tags like v21.1.0 umbrella break rook"],
      "matchDatasources": ["docker"],
      "matchPackagePatterns": ["ceph/ceph"],
      "allowedVersions": "<21"
    },
    {
      "description": ["Custom schedule for frequently updated container digests"],
      "matchDataSources": ["docker"],
      "matchPackagePatterns": ["postgresql"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["every 3 months on the first day of the month"]
    }
  ]
}
